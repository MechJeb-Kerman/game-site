{
  "name": "game-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "类 4399 的在线小游戏聚合站 — 纯 HTML + Express + node:sqlite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "reset": "node src/seed.js --force",
    "smoke": "node tools/browser-smoke.mjs",
    "test:account": "node tools/account-test.mjs",
    "test:features": "node tools/feature-test.mjs",
    "test:gamepad": "node tools/gamepad-test.mjs",
    "build:pages": "node tools/build-pages.mjs",
    "zip:cf": "node tools/zip-dist.mjs --dir=dist-cf --out=cloudflare-pages.zip",
    "serve:dist": "node tools/serve-dist.mjs",
    "smoke:pages": "node tools/pages-smoke.mjs",
    "test:worker": "node tools/worker-test.mjs",
    "serve:worker": "node tools/serve-worker.mjs",
    "test:worker-app": "node tools/worker-app-test.mjs",
    "test:worker-features": "node tools/worker-feature-test.mjs",
    "test:mail": "node tools/mail-oauth-test.mjs",
    "test:worker-mail": "node tools/worker-mail-oauth-test.mjs",
    "gen:changelog": "node tools/gen-changelog.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^4.22.3"
  }
