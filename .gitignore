# 依赖
node_modules/

# 本地数据库：里面有账号、会话、评论，别提交
data/*.db
data/*.db-wal
data/*.db-shm
data/worker*.db*

# 附件上传目录：本地自测（e2e 探针）会把图片落到这里，别提交
data/attachments/

# 构建产物：Cloudflare 的构建命令会重新生成，不用提交
# （如果按 DEPLOY-GITHUB-PAGES.md 的路线上传产物，用 git add -f dist 强制添加）
dist/
dist-cf/
cloudflare-pages.zip

# wrangler 的本地状态与本地密钥文件（.dev.vars 里通常放着管理员口令，绝不能提交）
.wrangler/
.dev.vars

# 拼音表数据源（约 12MB，重新获取：node tools/gen-pinyin.mjs --download）
.pinyin-src.txt

# OG 预生成位图：按库里的棋谱/主页/每日题生成（node tools/gen-og.mjs），随数据变，不进仓库。
# 缺了也不影响线上——src/og.js 会静默回落现场渲染。
public/og/

# 系统垃圾
.DS_Store
Thumbs.db
